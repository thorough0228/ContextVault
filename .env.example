# =============================================================================
# ContextVault 环境模板
# 复制为根目录 .env 并填入本地真实值。.env 绝不入库。
# 只列出需要关注/可能改动的键；未列出的键全部回落
# apps/api/app/config.py 的默认值（配置的完整权威参考）。
# =============================================================================

# ---- General ----
APP_ENV=development
# Comma-separated list of allowed origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 上传大小上限（字节）。默认 20MiB；大型数据集可放开。
UPLOAD_MAX_BYTES=20971520

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ContextVault

# ---- Database (PostgreSQL) ----
# 本地开发把 host 换成 localhost；DATABASE_URL 是权威 DSN。
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://contextvault:change-me-locally@postgres:5432/contextvault

# ---- Redis（broker 用 db1 / result backend 用 db2 / wiki 缓存 db0）----
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Object storage (MinIO) ----
S3_ENDPOINT_URL=http://minio:9000
S3_SECRET_KEY=change-me-locally

# ---- Auth ----
JWT_SECRET=change-me-locally
JWT_EXPIRES_MINUTES=60

# ---- MinIO bootstrap (used by infrastructure/minio-init) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally

# =============================================================================
# AI providers：默认 hash 桩（离线确定性）；换 `openai` 即接真实模型，
# 全部走同一抽象接口，chat / 检索 / 引用逻辑不变。
# =============================================================================

# ---- Embedding ----
# hash（离线）| openai（任何 OpenAI 兼容端点）| local（进程内
# sentence-transformers，无需 key；国内可设 HF_ENDPOINT 加速下载）：
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
#   EMBEDDING_DIMENSION=512
EMBEDDING_PROVIDER=hash
# 维度必须匹配模型真实输出；更换 provider/维度需迁移 0007 并重灌文档
EMBEDDING_MODEL=hash-256
EMBEDDING_DIMENSION=256
# Empty for `hash`. Required for `openai`.
EMBEDDING_OPENAI_API_KEY=
# Override for Azure / vLLM / SiliconFlow 等 OpenAI 兼容端点
EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- LLM (chat) ----
# 开源模型 API 示例（LLM_PROVIDER=openai 时改 base_url + model 即可）：
#   DeepSeek:    base_url=https://api.deepseek.com/v1   model=deepseek-flash
#   SiliconFlow: base_url=https://api.siliconflow.cn/v1 model=Qwen/Qwen2.5-7B-Instruct
#   Ollama 本地: base_url=http://localhost:11434/v1     model=qwen2.5:7b
LLM_PROVIDER=hash
LLM_MODEL=hash-llm
# 推理模型思考时间长，建议给足超时
LLM_TIMEOUT_SECONDS=30
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 评测 judge（可选）----
# 独立指定评卷模型：第三方非推理模型可消自评偏差并大幅提速。
# 置空则跟随主 LLM。
# JUDGE_LLM_MODEL=
# JUDGE_LLM_BASE_URL=
# JUDGE_LLM_API_KEY=

# =============================================================================
# 功能开关（Phase 12-19，按需启用；括号内为代码默认值）
# =============================================================================

# 混合检索 + rerank（vector=纯向量）
# SEARCH_MODE=hybrid
# SEARCH_RERANK_ENABLED=true
# PDF 解析引擎（auto=MinerU 官方 API 优先降级链；Token 见下）
# PDF_PARSER=auto
# MINERU_API_TOKEN=
# 查询驱动 wiki：边界路由 / 笔记沉淀 / 热缓存
# WIKI_ROUTE_ENABLED=false
# WIKI_ABSORB_ENABLED=false
# WIKI_CACHE_ENABLED=false
