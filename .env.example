# =============================================================================
# ContextVault — Phase 1 environment template
# Copy to .env (root) and fill in real values locally. Never commit .env.
# =============================================================================

# ---- General ----
APP_NAME=contextvault
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
# Comma-separated list of allowed origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ContextVault

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=contextvault
POSTGRES_USER=contextvault
# Replace locally. Must NOT be committed.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://contextvault:change-me-locally@postgres:5432/contextvault

# ---- Redis (cache + Celery broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Empty for local dev; set locally if Redis is password-protected.
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=contextvault
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-locally

# ---- Auth (placeholders — Phase 1 only reserves the surface) ----
JWT_SECRET=change-me-locally
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ---- MinIO bootstrap (used by infrastructure/minio-init) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally

# =============================================================================
# AI providers — Phase 4 (embedding) + Phase 5 (LLM)
# Default `hash` provider is deterministic and offline. Switch to `openai`
# to call a real model. Both go through the same abstract interface, so
# the chat pipeline / retrieval / citation logic doesn't change.
# =============================================================================

# ---- Embedding ----
# Values: hash (offline, SHA-256 → numpy) | openai | minimax
EMBEDDING_PROVIDER=hash
# Model name sent to the provider. For openai, examples:
#   OpenAI:    text-embedding-3-small  (1536 dims)
#   智谱 GLM:   embedding-3  (默认 2048 维；base_url 见下方) —
#              EMBEDDING_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# For minimax: embo-01 (1536 dims — see the MiniMax block below)
EMBEDDING_MODEL=hash-256
# MUST match the model's real output dimension. Mismatch → document
# is marked FAILED during ingestion. Changing provider/dimension also
# requires migration 0007 (re-aligns the vector column) and re-ingesting
# existing documents.
EMBEDDING_DIMENSION=256
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Used by the worker to reject chunks that are too long for the model.
EMBEDDING_MAX_CHARS_PER_INPUT=8000
# Empty for `hash`. Required for `openai`.
EMBEDDING_OPENAI_API_KEY=
# Override this for Azure, vLLM, llama.cpp-compatible gateway, etc.
EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Local embeddings (EMBEDDING_PROVIDER=local) ----
# 进程内 sentence-transformers，无需任何 API Key / 外部服务。
# 需要: pip install sentence-transformers（可选依赖，不装则启动时报错提示）
# 首次运行自动下载模型，国内可设 HF_ENDPOINT=https://hf-mirror.com 加速。
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIMENSION=512
# EMBEDDING_LOCAL_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ---- MiniMax embeddings (EMBEDDING_PROVIDER=minimax) ----
# MiniMax 的 /v1/embeddings 不是 OpenAI 兼容协议（需要 GroupId 查询参数、
# 请求体为 texts + type、响应为 vectors），由专门的 minimax provider 处理。
# 启用方式：EMBEDDING_PROVIDER=minimax + 下面三项必填，并把
# EMBEDDING_DIMENSION 改为 1536（embo-01 的输出维度）+ 执行迁移 0007。
# EMBEDDING_MINIMAX_API_KEY=your-minimax-api-key
# EMBEDDING_MINIMAX_GROUP_ID=your-group-id
# EMBEDDING_MINIMAX_BASE_URL=https://api.minimax.chat

# ---- LLM (chat) ----
# Values: hash (offline, deterministic) | openai (任何 OpenAI 兼容端点)
# 开源模型 API 示例（LLM_PROVIDER=openai 时改 base_url + model 即可）：
#   MiniMax-M3:      base_url=https://api.minimaxi.com/v1  model=MiniMax-M3
#   DeepSeek:        base_url=https://api.deepseek.com/v1  model=deepseek-chat
#   SiliconFlow:     base_url=https://api.siliconflow.cn/v1  model=Qwen/Qwen2.5-7B-Instruct
#   Ollama 本地:     base_url=http://localhost:11434/v1  model=qwen2.5:7b
LLM_PROVIDER=hash
LLM_MODEL=hash-llm
# 推理型模型（MiniMax-M3 / DeepSeek-R1 等）思考时间长，建议给足超时
LLM_TIMEOUT_SECONDS=30
# 去掉推理模型的 <think> 思考过程，只输出正文
LLM_STRIP_THINK=true
# Max tokens parameter sent to the provider (limits answer length).
LLM_MAX_CONTEXT_TOKENS=8000
# Empty for `hash`. Required for `openai`.
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Chat behaviour ----
# Number of recent turns the prompt builder includes (Phase 5).
CHAT_MAX_HISTORY_MESSAGES=8

# ---- Observability ----
# plain (default, single-line human-readable) | json (one object per line)
LOG_FORMAT=plain